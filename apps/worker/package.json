{
  "name": "@c360/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background worker for long-running AI, research, file and export jobs",
  "exports": {
    ".": "./src/index.ts",
    "./runner": "./src/runner.ts",
    "./handlers": "./src/handlers/index.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc -b"
  },
  "dependencies": {
    "@c360/api": "*",
    "@c360/config": "*",
    "@c360/contracts": "*",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.23.0",
    "pino": "^10.3.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@c360/testing": "*",
    "pino-pretty": "^13.1.3"
  }
}
