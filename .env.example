# Certify360 Marketing OS — local development configuration.
#
# Copy to `.env` and adjust. `.env` is git-ignored and must never contain a
# production secret; production configuration is injected by the platform, not
# by a file in the repository.

# ---------------------------------------------------------------- Runtime ---
NODE_ENV=development
LOG_LEVEL=debug

API_HOST=0.0.0.0
API_PORT=4000

# Exact browser origins allowed to call the API. The Vite dev server proxies
# /api, so the browser origin is the dev server's own.
CORS_ALLOWED_ORIGINS=http://localhost:5173

REQUEST_BODY_LIMIT_BYTES=1048576

# Two layers, because they answer different questions.
#
# This first one is keyed on the socket peer address and runs *before*
# authentication, so it is a whole-deployment circuit breaker against a flood.
# Behind the Entra ID proxy every request arrives from the same address, so it
# cannot tell one busy user from a hundred ordinary ones — do not treat it as a
# fair-use control, and raise it in step with the user count (roughly 75
# requests/min per user, times four for headroom).
RATE_LIMIT_MAX_PER_MINUTE=30000

# These run after authentication, where the actor and label are known. Sized in
# docs/architecture/load-assumptions.md.
RATE_LIMIT_USER_MAX_PER_MINUTE=600
RATE_LIMIT_USER_GENERATION_PER_MINUTE=20
RATE_LIMIT_LABEL_GENERATION_PER_MINUTE=60

# --------------------------------------------------------------- Database ---
# Pick ONE of the two, and uncomment it.
#
# A) Docker Compose (matches production). Host `postgres` from inside a
#    container, `localhost` when the API runs on the host.
# DATABASE_URL=postgresql://c360:c360_dev_password@localhost:5432/c360_dev
#
# B) Docker-free (`npm run dev:db`). PGlite over the PostgreSQL wire protocol on
#    port 5433, so it never collides with a real PostgreSQL on 5432. It serves a
#    single database called `postgres`; the user and password are not checked.
DATABASE_URL=postgresql://c360:c360@127.0.0.1:5433/postgres
# The real concurrency limit of this process. PostgreSQL's own max_connections
# must exceed the sum across all API replicas *and* workers.
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=15000

# --------------------------------------------------------------- Identity ---
# `local`         — fixed development test identity. Development only; the API
#                   refuses to start with this when NODE_ENV=production.
# `trusted-header`— production: identity headers written by the company proxy
#                   after it has authenticated the user against Entra ID.
AUTH_MODE=local

LOCAL_DEV_SUBJECT=dev-local-subject
LOCAL_DEV_EMAIL=dev@local.test
LOCAL_DEV_NAME=Lokale Testgebruiker

# Header names are configurable because the real proxy contract is not fixed
# yet. See docs/security/trusted-header-contract.md.
AUTH_HEADER_SUBJECT=x-c360-subject
AUTH_HEADER_EMAIL=x-c360-email
AUTH_HEADER_NAME=x-c360-name
AUTH_HEADER_PROXY_SECRET=x-c360-proxy-secret

# Required when AUTH_MODE=trusted-header. Only these peers may supply identity
# headers; deny-by-default when empty.
TRUSTED_PROXY_IPS=
# Required in production. Minimum 32 characters. Generate with:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
AUTH_PROXY_SHARED_SECRET=

# ----------------------------------------------------------------- Worker ---
# Generation jobs are I/O-bound and hold no transaction across the model call,
# so a slot costs a pending promise rather than a connection. Measured drain of
# 120 jobs on one worker: concurrency 4 -> 25.1s, 12 -> 8.6s, 24 -> 4.5s.
WORKER_CONCURRENCY=8
WORKER_POLL_INTERVAL_MS=1000
WORKER_HEARTBEAT_TIMEOUT_MS=180000

# Hard ceiling on concurrent jobs for one label, so a single label's burst
# cannot occupy every slot. Fair scheduling already prefers idle labels.
WORKER_MAX_JOBS_PER_LABEL=4

# How long a stopping worker waits for in-flight jobs before handing them back
# to the queue. Keep it comfortably below the container's termination grace
# period, or the process is killed before it can release anything.
WORKER_SHUTDOWN_GRACE_MS=25000

# Liveness/readiness/metrics port for the worker. 0 disables the probe server.
WORKER_HEALTH_PORT=4001

# ------------------------------------------------------------ AI provider ---
# `mock` produces clearly-labelled fake output for development. The API refuses
# to start with AI_PROVIDER=mock when NODE_ENV=production, so a production
# deployment can never silently serve fabricated content.
AI_PROVIDER=mock

# For real output, set AI_PROVIDER=openai and supply a paid API key. A ChatGPT
# subscription is not API access: requirement 12 forbids using one that way, and
# so do the provider's terms.
# OPENAI_API_KEY=
# OPENAI_ORGANIZATION=

# --- Through a gateway -------------------------------------------------------
# AI_PROVIDER=litellm sends the same two calls to a LiteLLM proxy instead of to
# OpenAI. The base URL carries no path: the adapter appends /v1/responses and
# /v1/images/generations itself. Production requires https, because prompts,
# documents and this key all travel over the connection.
# AI_PROVIDER=litellm
# LITELLM_BASE_URL=http://litellm:4000
# LITELLM_API_KEY=sk-your-virtual-key
#
# What a gateway can do depends on what is configured behind it, so nothing is
# assumed. The hosted web-search tool is OpenAI's; a proxy forwards it only when
# the model behind it has it. Leave this unset and the product refuses market
# discovery honestly instead of failing the call; set it to true when your proxy
# does forward it.
# AI_WEB_SEARCH_ENABLED=true
#
# AI_TEXT_MODEL is then the alias your proxy defines, and our own price table
# cannot know it. Give the price in eurocents per million tokens — both halves,
# because half a price is not a price. Without them an unpriced model still
# reserves a deliberately high placeholder and reports no actual cost at all,
# rather than a made-up one.
# AI_TEXT_PRICE_INPUT_CENTS_PER_MTOK=200
# AI_TEXT_PRICE_OUTPUT_CENTS_PER_MTOK=1200
#
# LiteLLM returns the real cost of each call in `x-litellm-response-cost`, in
# dollars. Set the euro rate and that figure becomes the recorded actual cost;
# leave it unset and the header is ignored, because a currency conversion nobody
# configured is a number nobody can check.
# AI_COST_USD_TO_EUR_RATE=0.92

# See docs/decisions/ADR-0015-openai-provider.md for the model/price table, and
# ADR-0019 for the gateway.
AI_TEXT_MODEL=gpt-5.6-terra

# No request timeout is needed for the *user*: generation runs as a worker job
# (ADR-0016). This is the ceiling on one provider call.
AI_REQUEST_TIMEOUT_MS=300000
# Ceiling per call, not a spend: you pay for the tokens actually produced.
# 4096 truncates the largest templates (a 36-answer persona questionnaire, a
# full brief); the adapter then refuses the half-document rather than saving it.
AI_MAX_OUTPUT_TOKENS=16000

# Image generation costs money per call and is off by default. With it off, the
# brand render layer still produces brand-correct images — which is what the
# requirements ask for anyway: logos and legible text are drawn by the render
# layer, never by a model.
AI_IMAGE_ENABLED=false
AI_IMAGE_MODEL=gpt-image-2.5-sunburst
AI_IMAGE_QUALITY=high
AI_IMAGE_TIMEOUT_MS=180000
# Default monthly AI budget per label, in eurocents (50000 = EUR 500,00).
AI_DEFAULT_LABEL_BUDGET_CENTS=50000

# ------------------------------------------- Outbound research (Phase 1+) ---
# Only https by default. The SSRF control is the resolved-address check, so
# this affects confidentiality rather than the attack surface.
RESEARCH_ALLOW_HTTP=false
# The whole redirect chain shares this budget, so five hops cannot cost five
# timeouts.
RESEARCH_FETCH_TIMEOUT_MS=10000
RESEARCH_MAX_RESPONSE_BYTES=2097152
RESEARCH_MAX_REDIRECTS=3
# When non-empty, only these hostname suffixes may be fetched.
RESEARCH_ALLOWED_HOST_SUFFIXES=

# ---------------------------------------------------------------- Storage ---
# A relative path is resolved against the repository root, so the api and the
# worker — separate processes, started from their own workspace folders — read
# and write the same files. An absolute path is used as given.
STORAGE_ROOT=./var/storage
UPLOAD_MAX_BYTES=26214400

# Internal published brand releases (server only)
# BRAND_PORTAL_BASE_URL=https://brand-api.internal.acc.certify360.com
# BRAND_PORTAL_API_KEY=

# Public advertisement-library research in Market Radar (requires Chromium).
AD_RESEARCH_ENABLED=true
# Optional system Chromium path; otherwise use Playwright-managed Chromium.
# AD_RESEARCH_BROWSER_EXECUTABLE_PATH=/path/to/chromium

# ChatGPT consumer answers through Bright Data; server-side only.
BRIGHT_DATA_API_KEY=
